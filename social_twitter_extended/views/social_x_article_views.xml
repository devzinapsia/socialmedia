<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_x_article_view_form" model="ir.ui.view">
        <field name="name">social.x.article.view.form</field>
        <field name="model">social.x.article</field>
        <field name="arch" type="xml">
            <form string="X Article">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="oe_highlight"
                        invisible="state not in ('draft', 'error') or post_method != 'now'"
                        groups="social.group_social_user"/>
                    <button name="action_schedule" string="Schedule" type="object" class="oe_highlight"
                        invisible="state not in ('draft', 'error') or post_method != 'scheduled'"
                        groups="social.group_social_user"/>
                    <button name="action_retry_comments" string="Retry comments" type="object" class="oe_highlight"
                        invisible="not twitter_comments_pending" groups="social.group_social_user"/>
                    <button name="action_set_draft" string="Reset to draft" type="object"
                        invisible="state != 'error'" groups="social.group_social_user"/>
                    <button name="action_set_draft" string="Cancel schedule" type="object"
                        invisible="state != 'scheduled'" groups="social.group_social_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,published"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </div>
                    <field name="cover_image" widget="image" class="oe_avatar"
                        readonly="state == 'published'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="title" placeholder="Title" readonly="state == 'published'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" options="{'no_create': True}"
                                readonly="state == 'published'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="post_method" widget="radio" invisible="state not in ('draft', 'error')"/>
                            <field name="scheduled_date"
                                invisible="post_method != 'scheduled' or state == 'published'"
                                required="post_method == 'scheduled' and state != 'published'"/>
                        </group>
                        <group>
                            <field name="utm_campaign_id" readonly="state == 'published'"
                                context="{'form_view_ref': 'social.utm_campaign_view_form_quick_create_social'}"/>
                            <field name="twitter_fixed_reply_template" invisible="1"/>
                            <field name="twitter_comments_pending" invisible="1"/>
                            <field name="twitter_reply_url" widget="url"
                                invisible="not twitter_fixed_reply_template"
                                readonly="state == 'published' and (not twitter_comments_pending or twitter_reply_post_id)"/>
                        </group>
                    </group>
                    <group>
                        <field name="twitter_first_comment" placeholder="Posted on X as a reply to the Article..."
                            readonly="state == 'published' and (not twitter_comments_pending or twitter_first_comment_post_id)"/>
                    </group>
                    <group string="Published on X" invisible="not twitter_article_id and not twitter_post_id">
                        <field name="twitter_url" widget="url" invisible="not twitter_url"/>
                        <field name="twitter_article_id"/>
                        <field name="twitter_post_id" invisible="not twitter_post_id"/>
                        <field name="twitter_first_comment_post_id" invisible="not twitter_first_comment_post_id"/>
                        <field name="twitter_reply_post_id" invisible="not twitter_reply_post_id"/>
                    </group>
                    <field name="body" widget="html" placeholder="Write or paste the Article here..."
                        readonly="state == 'published'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="social_x_article_view_list" model="ir.ui.view">
        <field name="name">social.x.article.view.list</field>
        <field name="model">social.x.article</field>
        <field name="arch" type="xml">
            <list string="X Articles">
                <field name="title"/>
                <field name="account_id"/>
                <field name="utm_campaign_id"/>
                <field name="scheduled_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'scheduled'"
                    decoration-success="state == 'published'"
                    decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="social_x_article_view_search" model="ir.ui.view">
        <field name="name">social.x.article.view.search</field>
        <field name="model">social.x.article</field>
        <field name="arch" type="xml">
            <search string="X Articles">
                <field name="title"/>
                <field name="account_id"/>
                <field name="utm_campaign_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Scheduled" name="filter_scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Published" name="filter_published" domain="[('state', '=', 'published')]"/>
                <filter string="Error" name="filter_error" domain="[('state', '=', 'error')]"/>
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="X account" name="group_by_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Scheduled date" name="group_by_scheduled_date" context="{'group_by': 'scheduled_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_social_x_article" model="ir.actions.act_window">
        <field name="name">X Articles</field>
        <field name="res_model">social.x.article</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an X Article</p>
            <p>Long-form rich text posts, published with an X account flagged as Pro account.</p>
        </field>
    </record>

    <!-- "Publish" in the Actions menu of the list, for the selected Articles -->
    <record id="action_social_x_article_publish" model="ir.actions.server">
        <field name="name">Publish</field>
        <field name="model_id" ref="model_social_x_article"/>
        <field name="binding_model_id" ref="model_social_x_article"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('social.group_social_user'))]"/>
        <field name="state">code</field>
        <field name="code">records.action_publish()</field>
    </record>

    <menuitem id="menu_social_x_article"
        name="X Articles"
        parent="social.menu_social_global"
        action="action_social_x_article"
        groups="social.group_social_user"
        sequence="25"/>
</odoo>
