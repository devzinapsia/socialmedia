<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Hourly fallback: scheduling an Article also triggers this cron at its exact date -->
    <record id="ir_cron_x_article_scheduled" model="ir.cron">
        <field name="name">Social: Publish scheduled X Articles</field>
        <field name="model_id" ref="model_social_x_article"/>
        <field name="state">code</field>
        <field name="code">model._cron_publish_scheduled()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
